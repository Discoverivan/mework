{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mework",
  "version": "0.1.0",
  "identifier": "com.discoverivan.app.mework",
  "mainBinaryName": "mework",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mework",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RkFCMzRCNDIwRUJFQzYKUldUR3ZnNUNTN1A2bVZIM2ZUUzIwd21BeXErMDRIZHo3Qi9yem9MVURSVzRONm5jQzJXVFV1UlgK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/Discoverivan/mework/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
